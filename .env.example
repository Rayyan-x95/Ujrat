# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-string
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Application URL
VITE_APP_URL=http://localhost:5173

# Edge Function CORS allow-list (server-side, no VITE_ prefix).
# The functions echo back the request Origin only when allow-listed.
# Set via: npx supabase secrets set ALLOWED_ORIGINS=https://ujrat.ninety5.in
# ALLOWED_ORIGINS=https://ujrat.ninety5.in
# Local dev fallback http://localhost:5173 is always allowed.

# Local-dev only: allow send-email to simulate delivery when no provider is
# configured. Never enable in production — without it the function fails
# closed with 503 instead of faking success.
# ALLOW_MOCK_EMAIL=true

# Plunk Email Platform (Open-Source Transactional Email)
# NOTE: This is a SERVER-SIDE secret for the send-email Edge Function.
# Do NOT prefix with VITE_ — that would bundle it into the browser and expose it publicly.
# Set it via: npx supabase secrets set PLUNK_API_KEY=sk_xxx
# PLUNK_API_KEY=sk_XXXXXXXXXX

# Sentry Error Tracking (optional but recommended)
VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token

# Optional: Analytics / Monitoring
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://app.posthog.com