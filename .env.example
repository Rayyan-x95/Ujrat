# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-string
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Application URL
VITE_APP_URL=http://localhost:5173

# Stripe card payments (client portal). Off by default: the card button only
# renders when VITE_STRIPE_ENABLED=true at build time, and both functions
# return 503 until their secrets are set via `npx supabase secrets set`.
# VITE_STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PORTAL_BASE_URL=https://ujrat.ninety5.in

# Edge Function CORS allow-list (server-side, no VITE_ prefix).
# The functions echo back the request Origin only when allow-listed.
# Set via: npx supabase secrets set ALLOWED_ORIGINS=https://ujrat.ninety5.in
# ALLOWED_ORIGINS=https://ujrat.ninety5.in
# Local dev fallback http://localhost:5173 is always allowed.

