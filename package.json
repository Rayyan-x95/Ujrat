{
  "name": "ujrat-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ujrat/frontend",
    "dev:backend": "python -m uvicorn backend.app.main:app --reload --port 8000",
    "build": "npm run build --workspace=@ujrat/frontend",
    "lint": "oxlint frontend",
    "typecheck": "tsc -b --noEmit",
    "validate:migrations": "node backend/scripts/validate-migrations.mjs",
    "validate:security": "node backend/scripts/validate-security.mjs",
    "test": "npm run test --workspace=@ujrat/frontend",
    "test:backend": "python -m unittest discover -s backend/tests -p \"test_*.py\"",
    "test:all": "npm run test && npm run test:backend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:load": "k6 run backend/k6/load-test.js",
    "test:load:smoke": "k6 run backend/k6/smoke-test.js",
    "preview": "npm run preview --workspace=@ujrat/frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.12"
  }
}
