# Normalize line endings: LF in the repo, CRLF is a checkout concern.
* text=auto eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.txt text eol=lf
# Binary assets must not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.ico binary
